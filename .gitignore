# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/simulated/.gitkeep
!data/simulated/README.md

# Track DVC pointer files, not the datasets themselves
!data/raw/*.dvc
!data/processed/*.dvc

*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.db

# Generated ML artifacts are versioned by DVC, not Git.
/artifacts/models/*
!/artifacts/models/pretrained/
/artifacts/models/pretrained/*
!/artifacts/models/pretrained/.gitkeep
!/artifacts/models/drifted/
/artifacts/models/drifted/*
!/artifacts/models/drifted/.gitkeep
/artifacts/metrics/
/artifacts/validation/

# Logs
logs/*
*.log

!logs/.gitkeep

# CI smoke-test artifacts
.ci-data/
.ci-output/

# Local MLflow tracking store
mlruns/

