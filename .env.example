# Local development configuration. Do not commit a populated .env file.
APP_ENV=development
MODEL_PATH=/models/model.pkl
MODEL_URI=
MODEL_VERSION=local
MODEL_THRESHOLD=0.5
MODEL_SHA256=
ALLOW_TRUSTED_PICKLE_MODEL=1

# Optional multi-model mode. When populated, MODEL_CATALOG_JSON replaces
# MODEL_PATH and MODEL_URI. Each entry must be explicitly allowlisted. In
# PowerShell, load a private completed catalog with:
# $env:MODEL_CATALOG_JSON = Get-Content -Raw configs/model-catalog.local.json
MODEL_CATALOG_JSON=
DEFAULT_MODEL_ID=
MODEL_LABEL=
MODEL_DESCRIPTION=
MODEL_DATASET=
MODEL_CUTOFF_DAYS=
API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,api,smart-study-planner-api
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave all three browser-authentication values blank to run an unsecured local
# research instance. Production requires all three. Generate the password hash
# with: python -m src.api.auth
WEB_AUTH_USERNAME=
WEB_AUTH_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=0

MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-secret
